{
  "manifest_version": 3,
  "name": "MILO Sync",
  "version": "1.2.0",
  "description": "Auto-sync Bridge Athletic to MILO dashboard daily at 8:30 AM & 10:00 AM. v1.2: widened set-history filter to catch all log formats.",
  "permissions": ["scripting", "storage", "activeTab", "alarms", "notifications"],
  "host_permissions": [
    "https://bridgeathletic.com/*",
    "https://milo-cyan.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MILO Sync"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
