    "metabolic-strength-ab": {
      "id": "metabolic-strength-ab",
      "name": "Metabolic Strength (A/B)",
      "description": "Metabolic finisher replaces intervals. Pick 3 strength exercises + 1 locomotion, run each for 15-20 seconds (no rep counting). Higher volume strength block (3-4 sets) up top. Can be supercharged into a giant set (1a-1b-2a-2b consecutive, no rest).",
