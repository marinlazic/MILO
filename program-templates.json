            { "pattern": "mobility",        "category": "t-spine",    "intensity": "accessory", "sets": 1, "reps": "1-2 min flow", "loaded": false, "pair": "1c", "note": "T-spine mobility reset" },
            { "pattern": "lunge",           "intensity": "secondary", "sets": "3-4", "reps": "10",         "loaded": true,  "pair": "2a" },
