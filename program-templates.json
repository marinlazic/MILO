    "hypertrophy-1-ab": {
      "id": "hypertrophy-1-ab",
      "name": "Hypertrophy 1",
      "progressionOrder": 5,
      "summary": {
        "style": "hypertrophy",
        "repScheme": "DUP · 4×6 / 2×20 / 3×12",
        "conditioning": "Complex finisher · 3-4 × 8"
      },
      "description": "Lightest of the hypertrophy series. Daily undulating periodization (DUP): three rep schemes rotate across the days of a week — each session uses a different one. Scheme 1 = 4×6 (strength bias), Scheme 2 = 2×20 (endurance/lactate buffer), Scheme 3 = 3×12 (classic hypertrophy). Exercise template (A/B) rotates separately. Replaces conditioning intervals with a complex finisher (3-4 sets × 8 reps per movement).",
      "tags": ["hypertrophy", "intermediate", "DUP"],
      "weeks": 6,
      "uniqueSessions": 2,
      "frequencyOptions": [2, 3, 4],
      "defaultFrequency": 3,
      "cyclingNote": "Each session in the week uses a different scheme from undulating.dailyRotation (Day 1 → scheme 1, Day 2 → scheme 2, Day 3 → scheme 3). Exercise template (A/B) alternates separately: at 3x/week the flow is A→B→A; at 4x/week run two full A-B cycles. Same exercises every week — schemes don't change across weeks, they change across DAYS within a week.",
      "undulating": {
        "_docs": "Daily undulating periodization (DUP). Each session in the week uses a different sets×reps scheme. Schemes rotate across day-of-week, NOT across week-of-block. Apply scheme N to the Nth session of the week. At <3 sessions/week, drop the last scheme(s). At >3, repeat from scheme 1.",
        "type": "daily",
        "dailyRotation": [
          { "day": 1, "sets": 4, "reps": 6,  "intent": "strength" },
          { "day": 2, "sets": 2, "reps": 20, "intent": "endurance" },
          { "day": 3, "sets": 3, "reps": 12, "intent": "hypertrophy" }
        ]
      },
      "sessions": [
        {
          "name": "Workout A",
          "blocks": [
            { "pattern": "anti_extension",   "intensity": "primary",   "sets": 2,     "reps": "30 seconds", "loaded": false, "note": "Core — Stability" },
            { "pattern": "power_lower",      "intensity": "primary",   "sets": 2,     "reps": "5-6",        "loaded": true,  "note": "Power slot — jumps / KB swing / med ball" },
            { "pattern": "hinge",            "intensity": "primary",   "sets": 4,     "reps": 6,            "loaded": true,  "pair": "1a", "note": "Sets×reps come from this session's scheme in undulating.dailyRotation (shown: scheme 1)" },
            { "pattern": "horizontal_push",  "intensity": "primary",   "sets": 4,     "reps": 6,            "loaded": true,  "pair": "1b", "note": "Superset with 1a · Day 1 = horizontal push · use this session's scheme" },
