{
  "_meta": {
    "lastEdited": null,
    "version": 1,
    "_docs": "Program-block templates organised by MOVEMENT PATTERN (not specific exercises). MILO uses these as the structural scaffold when generating a program: it picks one (or you pick one), then fills in actual exercises based on the athlete's coaching principles + considerations. Mobility prep (ankle / hip / t-spine) is added automatically on top of every session — it does NOT need to be in the template."
  },

  "_patternVocabulary": [
    "squat",
    "squat_unilateral",
    "hinge",
    "hinge_unilateral",
    "lunge",
    "horizontal_push",
    "horizontal_push_unilateral",
    "vertical_push",
    "horizontal_pull",
    "horizontal_pull_unilateral",
    "vertical_pull",
    "carry",
    "rotation",
    "anti_rotation",
    "anti_extension",
    "anti_lateral_flexion",
    "frontal_plane",
    "transverse_plane",
    "power_lower",
    "power_upper",
    "explosive_carry",
    "combination_total_body",
    "conditioning_zone_2",
    "conditioning_zone_5",
    "core_finisher"
  ],

  "_intensityLevels": ["primary", "secondary", "accessory", "finisher"],

  "templates": {
    "basic-training-ab": {
      "id": "basic-training-ab",
      "name": "Basic Training (A/B split)",
      "description": "Foundational 2-session split cycled across 4 workouts (A-B-A-B). Light volume, paired sets for time efficiency, intervals to cap each session. Good entry block for new clients or post-layoff return.",
      "tags": ["foundational", "basic", "2-session split", "general health"],
      "weeks": 2,
      "sessionsPerWeek": 2,
      "totalWorkouts": 4,
      "sessions": [
        {
          "name": "Workout A",
          "blocks": [
            { "pattern": "anti_extension", "intensity": "primary", "sets": "1-2", "reps": "30 seconds", "note": "Core — Stability" },
            { "pattern": "anti_rotation", "intensity": "primary", "sets": "1-2", "reps": "10", "note": "Core — Dynamic Stability" },
            { "pattern": "power_lower", "intensity": "primary", "sets": 2, "reps": "5", "note": "Power slot — coach picks (jumps / KB swing / med ball / etc.)" },
            { "pattern": "squat",           "intensity": "primary",   "sets": "1-2", "reps": "15", "pair": "1a" },
            { "pattern": "horizontal_pull", "intensity": "primary",   "sets": "1-2", "reps": "15", "pair": "1b", "note": "Superset with 1a" },
            { "pattern": "squat_unilateral","intensity": "secondary", "sets": "1-2", "reps": "15", "pair": "2a", "note": "Single-leg stance" },
            { "pattern": "horizontal_push", "intensity": "secondary", "sets": "1-2", "reps": "15", "pair": "2b", "note": "Superset with 2a" },
            { "pattern": "conditioning_zone_5", "intensity": "finisher", "sets": "2-4", "reps": "1 min work / 2 min recovery", "note": "Intervals" }
          ]
        },
        {
          "name": "Workout B",
          "blocks": [
            { "pattern": "anti_extension", "intensity": "primary", "sets": "1-2", "reps": "30 seconds", "note": "Core — Stability" },
            { "pattern": "anti_rotation", "intensity": "primary", "sets": 2, "reps": "10", "note": "Core — Dynamic Stability" },
            { "pattern": "combination_total_body", "intensity": "primary", "sets": 2, "reps": "5-8", "note": "Combination slot — total-body multi-joint movement (e.g. KB clean+press, thruster, complex)" },
            { "pattern": "hinge",           "intensity": "primary",   "sets": "1-2", "reps": "15", "pair": "1a" },
            { "pattern": "horizontal_push", "intensity": "primary",   "sets": "1-2", "reps": "15", "pair": "1b", "note": "Superset with 1a" },
            { "pattern": "lunge",           "intensity": "secondary", "sets": "1-2", "reps": "15", "pair": "2a" },
            { "pattern": "horizontal_pull", "intensity": "secondary", "sets": "1-2", "reps": "15", "pair": "2b", "note": "Superset with 2a" },
            { "pattern": "conditioning_zone_5", "intensity": "finisher", "sets": "2-4", "reps": "1 min work / 2 min recovery", "note": "Intervals" }
          ]
        }
      ],
      "notes": "Alternate Workout A and B over 4 sessions (A-B-A-B). Pairs marked 1a/1b and 2a/2b are supersets — back-to-back, then rest. Intervals can be bike, ski erg, row, or hill sprints based on equipment + conditioning goal. Mobility prep (ankle/hip/t-spine) is auto-added on top."
    }
  }
}
