      "weeks": 4,
      "uniqueSessions": 2,
      "frequencyOptions": [2, 3, 4],
      "defaultFrequency": 3,
      "cyclingNote": "Strength pairs 1a/1b and 2a/2b run normally. Metabolic 3a-3d done back-to-back, no rest between exercises (Alwyn Cosgrove giant-set option: 1a/1b/2a/2b combined into one giant set if you want to supercharge).",
      "sessions": [
        {
          "name": "Workout A",
          "blocks": [
            { "pattern": "anti_rotation",   "intensity": "primary",   "sets": 2,     "reps": "10",         "loaded": false, "note": "Core — Dynamic Stability" },
            { "pattern": "combination_total_body", "intensity": "primary", "sets": 2, "reps": "8-10",     "loaded": true,  "note": "Combination slot — KB clean+press / thruster" },
            { "pattern": "hinge",           "intensity": "primary",   "sets": "3-4", "reps": "10",         "loaded": true,  "pair": "1a" },
            { "pattern": "horizontal_push", "intensity": "primary",   "sets": "3-4", "reps": "10",         "loaded": true,  "pair": "1b", "note": "Superset with 1a · Day 1 = horizontal push" },
            { "pattern": "mobility",        "category": "hip",        "intensity": "accessory", "sets": 1, "reps": "1-2 min flow", "loaded": false, "pair": "1c", "note": "Hip mobility reset" },
            { "pattern": "single_leg",      "intensity": "secondary", "sets": "3-4", "reps": "10",         "loaded": true,  "pair": "2a", "note": "Single-leg stance" },
