            { "pattern": "combination_total_body", "intensity": "primary", "sets": 2, "reps": "8-10",     "loaded": true,  "note": "Combination slot" },
            { "pattern": "squat",           "intensity": "primary",   "sets": "3-4", "reps": "10",         "loaded": true,  "pair": "1a" },
