            { "pattern": "hinge",           "intensity": "finisher",  "sets": "1-2", "reps": "15-20 seconds", "loaded": true,  "pair": "3a", "note": "Metabolic — time-based, no rep count" },
            { "pattern": "horizontal_push", "intensity": "finisher",  "sets": "1-2", "reps": "15-20 seconds", "loaded": true,  "pair": "3b" },
            { "pattern": "locomotion",      "intensity": "finisher",  "sets": "1-2", "reps": "15-20 seconds", "loaded": false, "pair": "3c", "note": "Sled drag / bear crawl / farmer walk / sprint" },
